<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Arabic: culture data is needed, so full globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>Profile.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- One source of UI strings for the server renderer and the React app. -->
    <EmbeddedResource Include="../../web/src/i18n/strings.json" LogicalName="strings.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Profile.Api.Tests" />
  </ItemGroup>

</Project>

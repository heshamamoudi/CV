rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Personal Info - Public read, admin write
    match /personalInfo/{document} {
      // Anyone can read
      allow read: if true;
      
      // Only authenticated admin can write
      // For production, replace with: request.auth != null && request.auth.token.admin == true
      allow write: if request.auth != null;
    }
    
    // Experiences - Public read, admin write
    match /experiences/{document} {
      // Anyone can read
      allow read: if true;
      
      // Only authenticated users can write
      allow write: if request.auth != null;
    }
    
    // Side Experiences - Public read, admin write
    match /sideExperiences/{document} {
      // Anyone can read
      allow read: if true;
      
      // Only authenticated users can write
      allow write: if request.auth != null;
    }
    
    // Projects - Public read, admin write
    match /projects/{document} {
      // Anyone can read
      allow read: if true;
      
      // Only authenticated users can write
      allow write: if request.auth != null;
    }
    
    // Skills - Public read, admin write
    match /skills/{document} {
      // Anyone can read
      allow read: if true;
      
      // Only authenticated users can write
      allow write: if request.auth != null;
    }
    
    // Catch-all rule - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

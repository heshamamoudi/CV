# Filled by the selfhost panel when "Give it a database" is on.
ConnectionStrings__DefaultConnection=
# Public origin, no trailing slash. The test deploy uses its fikrahaive.com subdomain.
Site__BaseUrl=https://heshamamoudi.com
# false on the test subdomain: robots disallow all and every response is noindex.
Site__Indexable=true
# Cloudflare Access application "Portfolio admin" (Zero Trust -> Access -> Applications).
CloudflareAccess__TeamDomain=fikrahaive.cloudflareaccess.com
# The application's AUD tag.
CloudflareAccess__Audience=
# Comma-separated addresses allowed to use /admin.
CloudflareAccess__AllowedEmails=
